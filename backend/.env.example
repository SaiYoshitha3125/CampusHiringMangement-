# Django Configuration
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-398127391823
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL by default; if not configured or DB_ENGINE is sqlite, falls back to SQLite)
